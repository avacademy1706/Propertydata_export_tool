# ---------------------------------------------------------------------------
# Real Estate Data Tool - environment configuration
# Copy this file to .env and fill in values. Never commit a real .env file.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# Database (PostgreSQL). "docker compose up -d" provides this exact URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/real_estate_tool
# Optional separate database for integration tests (npm run test:integration)
TEST_DATABASE_URL=

# AI provider. Choose one:
#   gemini     - Google Gemini, FREE tier, great Hindi (key: aistudio.google.com/apikey)
#   groq       - Groq, free tier, fast (key: console.groq.com/keys)
#   openrouter - OpenRouter, has free models (key: openrouter.ai/keys)
#   ollama     - a local model, fully free, no key (needs Ollama installed)
#   anthropic  - Claude, paid, most accurate (key: console.anthropic.com)
#   rules      - offline heuristic extractor, no key, weak on Hindi
# Leave AI_API_KEY blank and the app falls back to the offline rules extractor.
AI_PROVIDER=gemini
AI_API_KEY=
# AI_MODEL is optional; each provider has a sensible default
#   gemini -> gemini-2.0-flash | groq -> llama-3.3-70b-versatile | anthropic -> claude-opus-5-5
AI_MODEL=
# Override the provider endpoint only for a custom/self-hosted gateway or Ollama
AI_BASE_URL=
# Set to "true" to let the AI describe uploaded property photos (Anthropic only; suggestions only)
AI_VISION_ENABLED=false

# WhatsApp Cloud API (leave blank until credentials are supplied; the app works
# in manual-paste mode without them)
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v26.0
# Send a short WhatsApp acknowledgement after processing an inbound message
WHATSAPP_SEND_ACKNOWLEDGEMENTS=false
# What to do with messages from numbers that are not on the allowed-sender list:
# reject | hold | default_tenant
WHATSAPP_UNKNOWN_SENDER_POLICY=hold

# Media storage: local (default) or s3
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_DIR=./storage/media
MEDIA_MAX_FILE_MB=50
# S3-compatible storage (only when MEDIA_STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Security
# AUTH_SECRET signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# When APP_ACCESS_PASSWORD is set the dashboard and API require a login.
# Leave blank for trusted local development only.
APP_ACCESS_PASSWORD=

# Optional: URL of a locally served GridCraft web build to link from the dashboard
GRIDCRAFT_WEB_URL=

# Optional: log full message text for debugging (off by default for privacy)
LOG_MESSAGE_CONTENT=false
